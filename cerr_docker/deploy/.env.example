# TODO: Configure the deployment
PROJECT_NAME=nmrr
IMAGE_NAME=cerr
IMAGE_VERSION=2.21.0
HOSTNAME=#IP_ADDRESS
SERVER_URI=http://# IP_ADDRESS
ALLOWED_HOSTS=*
SERVER_NAME="CERR"
SERVER_CONF=default
SETTINGS=settings

ENABLE_SAML2_SSO_AUTH=False

# TODO: Set values for the databases configuration and credentials
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASS=changeme
MONGO_USER=curator
MONGO_PASS=changeme
MONGO_DB=cdcs
POSTGRES_USER=curator
POSTGRES_PASS=changeme
POSTGRES_DB=cdcs
REDIS_PASS=changeme
DJANGO_SECRET_KEY=changeme

# TODO: Set versions for the components of the CDCS stack
MONGO_VERSION=4.4
REDIS_VERSION=5.0
